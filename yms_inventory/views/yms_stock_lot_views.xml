<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_yms" model="ir.ui.view">
        <field name="name">stock.lot.form.yms</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="yms_barcode"/>
                <field name="yms_quality_status"/>
                <field name="yms_putaway_eligible"/>
                <field name="yms_quality_date"/>
                <field name="yms_quality_user_id"/>
                <field name="yms_verify_status"/>
                <field name="yms_verify_physical_qty"/>
                <field name="yms_verify_variance"/>
                <field name="yms_verify_date"/>
                <field name="yms_verify_user_id"/>
                <field name="yms_verify_remarks"/>
            </xpath>
        </field>
    </record>
    <record id="view_production_lot_tree_yms" model="ir.ui.view">
        <field name="name">stock.lot.list.yms</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="yms_barcode" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
